*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
/data/*
!/data/.gitkeep

# Local diagnostics and acceptance output
*.log
/test-results/
/playwright-report/
/acceptance.json

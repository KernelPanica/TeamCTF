# Python environments, caches and build output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.coverage
.coverage.*
htmlcov/

# Local configuration and credentials; keep distributable examples
.env
.env.*

# Public bind address for the Portal host. Keep 127.0.0.1 behind a reverse proxy.
PORTAL_BIND=127.0.0.1
ARENA_URL=https://arena.mtuci.fun:8443
# Generate locally; never commit the real token.
ARENA_TOKEN=
# Optional when Arena uses a private CA or a self-signed test certificate.
# ARENA_CA_FILE=/etc/cyberrange/arena-ca.pem
